# ============================================================
# platemate backend configuration template
#   cp backend/.env.example backend/.env   then fill in real values
#   backend/.env is gitignored. Never commit it.
# ============================================================

# ---- Django ----
# Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# 'prod' selects PostgreSQL; anything else falls back to SQLite.
DJANGO_ENV=dev
DEBUG=false

# ---- OpenAI (platform.openai.com/api-keys) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ---- Textbelt SMS (textbelt.com) ----
TEXTBELT_API_KEY=

# ---- PostgreSQL (used only when DJANGO_ENV=prod) ----
POSTGRES_DB=platemate
POSTGRES_USER=platemate
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# ---- HTTPS / hosts ----
USE_HTTPS=false
PRODUCTION_HOST=
FRONTEND_PORT=520
BACKEND_PORT=911
LOCAL_HTTPS_HOST=localhost
HTTPS_PORT=5200
