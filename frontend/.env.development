# 本地开发环境配置
# Frontendreaches the backend container over the Docker network

# 开发环境：连接到Docker容器的web-dev
VITE_API_BASE_URL=/api
VITE_BACKEND_HOST=web-dev
VITE_BACKEND_PORT=911
VITE_BACKEND_PROTOCOL=http
VITE_FRONTEND_PORT=520

# Note: Vite proxy会自动将 /api 请求代理到 http://web-dev:911
# 不需要完整URL，只需要 /api 即可
